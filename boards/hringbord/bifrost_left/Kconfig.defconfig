if BOARD_BIFROST_LEFT

config BOARD
    default "bifrost_left"

config ZMK_KEYBOARD_NAME
    default "Bifrost"

# Private IDs: low 16 bits of SHA-256 over UTF-8 strings (no newline).
# VID: "hringdrifi"; PID: "hringdrifi/bifrost". Keep stable across releases.
config USB_DEVICE_VID
    default 0x9517

config USB_DEVICE_PID
    default 0xFF99

choice ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE
    default ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE_ADAFRUIT_NRF52
endchoice

config BT_DIS_PNP_VID
    default 0x9517

config BT_DIS_PNP_PID
    default 0xFF99

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif # BOARD_BIFROST_LEFT
