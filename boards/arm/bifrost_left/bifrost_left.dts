/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "Bifrost left";
    compatible = "hringbord,bifrost_left";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <49>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,29) RC(0,25) RC(0,26) RC(0,27) RC(0,24)
            RC(0,28) RC(0,5) RC(0,30) RC(0,32) RC(0,33) RC(0,34) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(0,31) RC(0,10) RC(0,35) RC(0,11) RC(0,12) RC(0,13) RC(0,36) RC(0,38) RC(0,39) RC(0,40)
            RC(0,41) RC(0,14) RC(0,15) RC(0,42) RC(0,37) RC(0,16) RC(0,43) RC(0,44) RC(0,45) RC(0,46)
            RC(0,17) RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,47) RC(0,23) RC(0,48)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 0: P1.00 */
            , <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 1: P0.25 */
            , <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 2: P1.02 */
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 3: P1.11 */
            , <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 4: P1.10 */
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 5: P0.17 */
            , <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 6: P0.21 */
            , <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 7: P0.15 */
            , <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 8: P0.13 */
            , <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 9: P1.05 */
            , <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 10: P1.03 */
            , <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 11: P0.19 */
            , <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 12: P1.06 */
            , <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 13: P1.01 */
            , <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 14: P1.12 */
            , <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 15: P0.03 */
            , <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 16: P0.02 */
            , <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 17: P0.23 */
            , <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 18: P1.07 */
            , <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 19: P1.04 */
            , <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 20: P0.07 */
            , <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 21: P0.30 */
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 22: P0.28 */
            , <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Direct 23: P0.26 */
            ;
    };


};
/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split_0: trackball_split_0@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener_0: trackball_listener_0 {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split_0>;
    };
};

&trackball_listener_0 {
    status = "okay";
};



&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&gpiote {
    status = "okay";
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        code_partition: partition@26000 {
            label = "code_partition";
            reg = <0x00026000 0x000d2000>;
        };

        storage_partition: partition@f8000 {
            label = "storage";
            reg = <0x000f8000 0x00008000>;
        };
    };
};

