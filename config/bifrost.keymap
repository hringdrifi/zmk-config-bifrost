#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER 1
#define RAISE 2
#define MOUSE 3

/ {
    keymap {
        compatible = "zmk,keymap";

        /* Base: familiar QWERTY with dedicated shifts and thumb layers. */

        layer_0 {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS  &kp BSLH  &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp RET  &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp UP  &kp RSHIFT  &kp LCTRL  &kp LGUI  &kp LALT  &trans  &lt 1 SPACE  &kp ESC  &kp BACKSPACE  &lt 2 DEL  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        /* Lower: numbers, symbols, and right-hand pointing controls. */

        layer_1 {
            display-name = "LOWER";
            bindings = <
&trans  &kp EXCL  &kp DQT  &kp HASH  &kp DLLR  &kp PRCNT  &kp AMPS  &kp SQT  &kp LPAR  &kp RPAR  &kp N0  &kp MINUS  &kp EQUAL  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans  &trans  &kp GRAVE  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &mkp LCLK  &mkp MCLK  &mkp RCLK  &msc SCRL_DOWN  &msc SCRL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &trans  &studio_unlock  &kp HOME  &kp PG_DN  &kp END
            >;
        };

        /* Raise: function keys, navigation, and editing shortcuts. */

        layer_2 {
            display-name = "RAISE";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp INSERT  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL  &trans  &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(A)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &trans  &bootloader  &trans  &kp HOME  &kp PG_DN  &kp END
            >;
        };

        layer_3 {
            display-name = "MOUSE";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &mkp LCLK &mkp MCLK &mkp RCLK &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
